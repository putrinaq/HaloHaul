# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# worker/migrate/seed bundles
/dist/

# env files: only the examples are committed
!.env.example
backup.env
!backup.env.example

# design exports live in Figma; keep the index only
/design/*
!/design/README.md

# local editor scratch
/text

# local PGlite database (npm run db:local)
/.pglite/
