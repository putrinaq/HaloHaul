# Read only by scripts/backup.sh and scripts/restore.sh on the host.
# Copy to /opt/halohaul/backup.env and chmod 600. Never commit backup.env.
#
# Use an R2 API token scoped to the backup bucket only (Object Read & Write),
# separate from the app's photo-bucket token, so an app compromise can't touch
# backups.

BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=halohaul-backups

# Days to keep backups in R2.
BACKUP_RETENTION_DAYS=14
