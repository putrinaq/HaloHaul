# Copy to .env and fill in. Never commit .env.
# On the VPS this lives at /opt/halohaul/.env (chmod 600).

# ---- deploy ------------------------------------------------------------------
# Lowercase GitHub owner that publishes the images to GHCR.
GHCR_OWNER=putrinaq
# Image tag to run. CI rewrites this to the commit SHA on each deploy;
# set it to an older SHA to roll back.
IMAGE_TAG=latest
DOMAIN=halohaul.example.com
ACME_EMAIL=ops@example.com

# ---- database ----------------------------------------------------------------
POSTGRES_USER=halohaul
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=halohaul
# Inside Docker the host is "postgres"; locally use localhost.
DATABASE_URL=postgres://halohaul:change-me-long-random@postgres:5432/halohaul

# ---- app ---------------------------------------------------------------------
# Public base URL, no trailing slash.
APP_URL=https://halohaul.example.com
# openssl rand -base64 48
BETTER_AUTH_SECRET=

# ---- email (Resend) ----------------------------------------------------------
# Leave empty in local dev to print emails to the console. Required in production.
RESEND_API_KEY=
EMAIL_FROM=HaloHaul <hello@halohaul.example.com>

# ---- Cloudflare R2: photos (private bucket) ----------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=halohaul-photos

# Backup credentials live in backup.env (see backup.env.example), NOT here:
# everything in this file is passed into the app and worker containers.

# Admin pages require 2FA. Set to false to skip it in local development only;
# production always requires it, whatever this says.
ADMIN_REQUIRE_2FA=true

# ---- seed (first run only) ---------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
