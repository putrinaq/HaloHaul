# Evolution API's own settings. deploy/evolution/setup.sh makes evolution.env from
# this with fresh secrets. Never commit evolution.env, and never put HaloHaul's
# secrets in it: the container only gets what's here.
AUTHENTICATION_API_KEY=@KEY@
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:@DBPASS@@postgres:5432/evolution?schema=public&connection_limit=4
DATABASE_CONNECTION_CLIENT_NAME=halohaul

SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://evolution:8080
SERVER_DISABLE_DOCS=true
SERVER_DISABLE_MANAGER=true
CORS_ORIGIN=http://app:3000
CORS_METHODS=GET,POST,DELETE

# Messages are kept 3 days (setup.sh) so a lost one can be resent properly.
# Everything else stays off.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_IS_ON_WHATSAPP=false

CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true
TELEMETRY_ENABLED=false
PROMETHEUS_METRICS=false
DEL_INSTANCE=false
QRCODE_LIMIT=30
CONFIG_SESSION_PHONE_CLIENT=HaloHaul
CONFIG_SESSION_PHONE_NAME=Chrome
LOG_LEVEL=ERROR,WARN
LOG_BAILEYS=error
LANGUAGE=en
TZ=Asia/Kuala_Lumpur
NODE_OPTIONS=--max-old-space-size=320
